[
 {
  "start": 0.0,
  "end": 5.16,
  "text": "اللهم جعل لنا في صباح يوم الإفنين باباً إلى الفرح لا يسد"
 },
 {
  "start": 6.5,
  "end": 8.32,
  "text": "ورزقاً مباركاً لا يعد"
 },
 {
  "start": 9.5,
  "end": 11.58,
  "text": "ودعاءاً مستجاباً لا يرد"
 },
 {
  "start": 12.5,
  "end": 13.16,
  "text": "يا رب"
 },
 {
  "start": 14.0,
  "end": 18.04,
  "text": "اجعل هذا اليوم بدايةً لشفاء كل مريض"
 },
 {
  "start": 18.04,
  "end": 20.56,
  "text": "ورزقاً لكل محتاج"
 },
 {
  "start": 21.5,
  "end": 23.26,
  "text": "ورحمةً لكل ميت"
 },
 {
  "start": 24.0,
  "end": 27.64,
  "text": "برحمتك يا رحم الراحمين"
 }
]