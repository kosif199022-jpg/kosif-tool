{
  "name": "kosif-remotion-starter",
  "version": "0.1.0",
  "private": true,
  "description": "KOSIF TOOL starter for Remotion v4: staggered Arabic/English title, animated SVG line chart, closing logo card and word-level captions in a 1080x1920 film.",
