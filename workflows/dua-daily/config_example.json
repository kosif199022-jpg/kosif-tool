   "end": 3.3,
   "text": "اللهم في صباح يوم الثلاثاء"
  },
  {
   "start": 3.3,
   "end": 7.2,
   "text": "افتح لنا أبواب رحمتك\nوأبواب رزقك"
  },
  {
   "start": 7.2,
   "end": 9.2,
   "text": "واشرح صدورنا بنورك"
  },
  {
   "start": 9.2,
   "end": 13.3,
   "text": "ويسّر لنا أمورنا كلها"
  },
  {
   "start": 13.3,
   "end": 15.9,
   "text": "واكتب لنا الخير حيث كان"
  },
  {
   "start": 15.9,
   "end": 18.2,
   "text": "وارضَ عنا رضاً لا سخط بعده"
  },
  {
   "start": 18.2,
