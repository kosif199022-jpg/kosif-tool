{
 "schema": "kosif.dm.required_tools.v1",
 "updated": "2026-11-07",
 "tiers": {
  "required": "لازم — من غيرها المحطة متشتغلش",
  "recommended": "مهمة — من غيرها الجودة بتقل واضح",
  "optional": "إضافات — بتفتح مزايا زيادة"
 },
 "stations": {
  "analyze": {
   "ar": "العين الأولى",
   "en": "Analyse footage"
  },
  "think": {
   "ar": "يفهم المطلوب ويفكر بإبداع",
   "en": "Brief + creative concepts"
  },
  "taste": {
   "ar": "يختار الذوق",
   "en": "Pick a look"
  },
  "direct": {
   "ar": "يكتب المونتاج",
   "en": "Write the EDL"
  },
  "render": {
   "ar": "يرندر",
   "en": "Render"
  },
  "review": {
   "ar": "يتفرج وينقد",
   "en": "Review and fix"
  },
  "generate": {
   "ar": "يولّد الناقص",
   "en": "Generate missing shots/music/voice"
  }
 },
 "tools": [
  {
   "id": "python",
   "name": "Python 3.10+",
   "tier": "required",
   "purpose": {
    "ar": "اللغة اللي كل محطات المونتاج مكتوبة بيها",
    "en": "Runs every Dragon Montage station script"
   },
   "stations": [
    "analyze",
    "think",
    "taste",
    "direct",
    "render",
    "review",
    "generate"
   ],
   "features": [
    "all"
   ],
   "check": [
    {
     "kind": "python",
     "min": "3.10"
    }
   ],
   "breaks_without": "مفيش ولا محطة تشتغل",
   "size": "~100 MB",
   "install": {
    "linux": {
     "apt": [
      "python3",
      "python3-venv",
      "python3-pip"
     ]
    },
    "macos": {
     "brew": [
      "python@3.13"
     ]
    },
    "windows": {
     "winget": [
      "Python.Python.3.13"
     ],
     "choco": [
      "python313"
     ]
    },
    "ashell": {
     "builtin": true,
     "note": "a-Shell فيه python3 جاهز"
    }
   }
  },
  {
   "id": "ffmpeg",
   "name": "FFmpeg",
   "tier": "required",
   "purpose": {
    "ar": "القص والتركيب والتلوين والانتقالات والصوت والترجمة المحروقة والتصدير",
    "en": "Cuts, xfade transitions, grading, loudness, burned captions, final encode"
   },
   "stations": [
    "analyze",
    "render",
    "review",
    "generate"
   ],
   "features": [
    "cut",
    "xfade",
    "look_pipeline",
    "loudnorm",
    "subtitles",
    "contact_sheet"
   ],
   "check": [
    {
     "kind": "bin",
     "name": "ffmpeg"
    }
   ],
   "breaks_without": "مفيش رندر خالص؛ مفيش استخراج صوت ولا صور للفحص",
   "size": "~80-150 MB",
   "install": {
    "linux": {
     "apt": [
      "ffmpeg"
     ]
    },
    "macos": {
     "brew": [
      "ffmpeg"
     ]
    },
    "windows": {
     "winget": [
      "Gyan.FFmpeg"
     ],
     "choco": [
      "ffmpeg"
     ]
    },
    "ashell": {
     "builtin": true,
     "note": "a-Shell بييجي معاه ffmpeg و ffprobe جاهزين"
    }
   },
   "notes": "Windows: بعد winget افتح ترمينال جديد عشان PATH يتحدث."
  },
  {
   "id": "ffprobe",
   "name": "FFprobe",
   "tier": "required",
   "purpose": {
    "ar": "يقيس الفيديو: المدة والأبعاد والفريمات ووجود الصوت",
    "en": "Measures media: duration, size, fps, audio streams; verify_video uses it"
