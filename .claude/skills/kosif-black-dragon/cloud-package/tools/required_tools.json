  {
   "id": "opencv",
   "name": "OpenCV (headless)",
   "tier": "recommended",
   "purpose": {
    "ar": "قراءة الفريمات: الحدة والاهتزاز والوشوش والحركة وإعادة التأطير 9:16",
    "en": "Frame analysis: sharpness, shake, faces, motion, smart 9:16 reframe"
