   "size": "بييجي مع ffmpeg",
   "install": {
    "linux": {
     "apt": [
      "ffmpeg"
     ]
    },
    "macos": {
     "brew": [
      "ffmpeg"
     ]
    },
    "windows": {
     "winget": [
      "Gyan.FFmpeg"
     ],
     "choco": [
      "ffmpeg"
     ]
    },
    "ashell": {
     "builtin": true,
     "note": "a-Shell بييجي معاه ffmpeg و ffprobe جاهزين"
    }
   }
  },
  {
