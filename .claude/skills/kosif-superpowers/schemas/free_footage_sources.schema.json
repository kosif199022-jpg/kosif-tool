{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/kosif199022-jpg/kosif-tool/.claude/skills/kosif-superpowers/schemas/free_footage_sources.schema.json",
 "title": "KOSIF free-footage sources (data/free_footage_sources.json)",
 "description": "Open-licence and free video sources for montage, one record per source. Read by scripts/free_footage.py; scripts/free_footage.py check validates the file against the same rules with the standard library (required keys, enums, unique ids, template placeholders).",
 "type": "object",
 "required": [
  "schema",
  "checked_on",
  "about",
  "notice",
  "template_fields",
  "sources"
 ],
 "properties": {
  "schema": {
   "const": "kosif.free-footage-sources.v1"
  },
  "checked_on": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "about": {
   "type": "string"
  },
  "notice": {
   "type": "string"
  },
  "reachability_note": {
   "type": "string"
  },
  "template_fields": {
   "type": "array",
   "items": {
    "enum": [
     "title",
     "author",
     "source",
     "licence",
     "licence_url",
     "page_url"
    ]
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/source"
   }
  }
 },
 "$defs": {
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "name",
    "url",
    "category",
    "licence_source",
    "licence",
    "attribution",
    "commercial_use",
    "commercial_note",
    "modification",
    "video_kinds",
    "strengths",
    "search_url",
    "search_url_checked",
    "api",
    "download",
    "max_resolution",
    "formats",
    "tool",
    "probes",
    "reachability",
    "notes"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    },
    "category": {
     "enum": [
      "free-stock",
      "freemium-stock",
      "open-collection",
      "public-agency",
      "media-api",
      "discovery-only",
      "paid-stock"
     ]
    },
    "licence_source": {
     "type": "boolean",
     "description": "false when the site grants no reuse licence at all (Pinterest: credit/link only)."
    },
    "licence": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "url",
      "per_item",
      "summary"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "url": {
       "type": "string",
       "pattern": "^https://"
      },
      "per_item": {
       "type": "boolean",
       "description": "true when each clip carries its own licence, so the source-level name is only a summary."
      },
      "summary": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "attribution": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "required",
      "per_item",
      "template"
     ],
     "properties": {
      "required": {
       "type": "boolean"
      },
      "per_item": {
       "type": "boolean",
       "description": "true when the requirement is decided per clip (CC0 vs CC BY on Commons); required then states the safe default."
      },
      "template": {
       "type": [
        "string",
        "null"
       ],
       "description": "Credit line with {title} {author} {source} {licence} {licence_url} {page_url} placeholders."
      }
     }
    },
    "commercial_use": {
     "enum": [
      "yes",
      "no",
      "per-item",
      "n/a"
     ]
    },
    "commercial_note": {
     "type": "string"
    },
    "modification": {
     "enum": [
      "yes",
      "no",
      "per-item",
      "n/a"
     ],
     "description": "Whether edits (a montage is an adaptation) are allowed; ND licences forbid them."
    },
    "video_kinds": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "strengths": {
     "type": "string"
    },
    "search_url": {
     "type": [
      "string",
      "null"
     ],
     "description": "Web search URL with a {query} placeholder."
    },
    "search_url_checked": {
     "type": "boolean"
    },
    "api": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "endpoint",
      "key_required",
      "key_env",
      "docs",
      "notes"
     ],
     "properties": {
      "endpoint": {
       "type": [
        "string",
        "null"
       ]
      },
      "key_required": {
       "type": "boolean"
      },
      "key_env": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^[A-Z][A-Z0-9_]*$",
       "description": "The environment variable the key is read from; never the key itself."
      },
      "docs": {
       "type": [
        "string",
        "null"
       ]
      },
      "notes": {
       "type": "string"
      }
     }
    },
    "download": {
     "type": "string",
     "description": "How a file URL is obtained."
    },
    "max_resolution": {
     "type": "string"
    },
    "formats": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tool": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "search",
      "download"
     ],
     "properties": {
      "search": {
       "enum": [
        "api",
        "api-key",
        "scrape",
        "none"
       ]
      },
      "download": {
       "enum": [
        "api",
        "direct",
        "none"
       ]
      }
     }
    },
    "probes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "what",
       "url"
      ],
      "properties": {
       "what": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https://"
       },
       "expect": {
        "type": "integer",
        "description": "The status that means 'working as designed' (401 for an API without a key)."
       }
      }
     }
    },
    "reachability": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "checked_on",
      "status",
      "http",
      "detail"
     ],
     "properties": {
      "checked_on": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "status": {
       "enum": [
        "ok",
        "partial",
        "blocked",
        "timeout",
        "needs-key",
        "paid",
        "moved",
        "not-checked"
       ]
      },
      "http": {
       "type": [
        "integer",
        "null"
       ]
      },
      "detail": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "string"
    }
   }
  }
 }
}
