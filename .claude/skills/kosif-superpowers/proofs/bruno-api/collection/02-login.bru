meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {"user": "{{user}}", "password": "{{password}}"}
}

script:post-response {
  bru.setVar("token", res.body.token);
}

tests {
  test("login returns a token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().token).to.be.a("string").and.not.empty;
  });
}
