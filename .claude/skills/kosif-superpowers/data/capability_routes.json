      "script": "scripts/creative_quality_gate.py",
      "subcommand": "--help",
      "requires": [
        "python3"
      ],
      "permissions": [
        "read_user_files"
      ],
      "proof": "pass/fail measured structural checks only",
      "external": "promptfoo/promptfoo",
      "summary": "No guarantee of visual beauty, user likeness or semantic fidelity."
    },
    {
      "id": "compositing",
      "title": "Composite visual effects via authorized external engine",
