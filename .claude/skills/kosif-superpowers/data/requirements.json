{
 "_note": "Requirement registry used by scripts/requirements.py. key → how to detect it on this machine, how to install it, what it unlocks. kind: bin (executable on PATH), pip (python package), npm (node package), apt (system package), key (API key or account), service (hosted service/connector), os (platform), font (font file), model (downloaded model weights). Edit here, then run: python3 scripts/requirements.py derive && python3 scripts/requirements.py index",
 "ffmpeg": {
  "kind": "bin",
  "detect": "ffmpeg",
  "install": "apt-get install -y ffmpeg  (or: conda install ffmpeg)",
  "ar": "قص ودمج وترميز وضبط علوّ الصوت وحرق الترجمات واستخراج الإطارات",
  "en": "cut, concat, transcode, loudnorm, burn captions, extract frames/audio",
  "patterns": [
   "\\bffmpeg\\b",
   "\\bffprobe\\b",
   "\\bxfade\\b",
   "\\bloudnorm\\b",
   "\\blibass\\b"
  ]
 },
