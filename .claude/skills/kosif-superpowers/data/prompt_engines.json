{
  "schema": "kosif.prompt_engines.v1",
  "note": "Delivery adapters for scripts/prompt_pack.py. Each entry only APPENDS a documented suffix after the user's prompt text; the prompt words are never changed. Syntax marked version_sensitive was written from public documentation for the named version and has not been run against the engine here (badge: documented). Check the engine's current docs before relying on a flag.",
  "default_engine": "generic-image",
  "engines": {
    "midjourney": {
      "label": "Midjourney",
      "medium": "image",
      "version": "7",
      "version_sensitive": true,
      "evidence": "documented",
      "negative": "flag",
      "negative_flag": "--no",
      "version_flag": "--v 7",
      "params": {
        "ar": "--ar {v}",
        "aspect": "--ar {v}",
        "stylize": "--stylize {v}",
        "chaos": "--chaos {v}",
        "seed": "--seed {v}",
        "weird": "--weird {v}",
        "quality": "--quality {v}",
        "raw": "--raw",
        "draft": "--draft",
        "tile": "--tile"
      },
      "suffix_join": " ",
      "doc_note": "Parameters go at the very end of the prompt, after the text, separated by spaces (V7 syntax). --no takes a comma-separated list."
    },
    "generic-image": {
      "label": "Generic image model (Flux, SDXL, Imagen, GPT-image, ...)",
      "medium": "image",
      "version": null,
      "version_sensitive": false,
      "evidence": "documented",
      "negative": "line",
      "negative_label": "Negative prompt:",
      "params": {
        "ar": "Aspect ratio {v}.",
        "aspect": "Aspect ratio {v}.",
        "seed": "Seed {v}."
      },
      "suffix_join": "\n\n",
      "doc_note": "Plain text. If the tool has a separate negative-prompt field, paste the 'Negative prompt:' line there instead."
    },
    "generic-video": {
      "label": "Generic video model (Veo, Runway, Pika, Kling, Sora, ...)",
      "medium": "video",
      "version": null,
      "version_sensitive": false,
      "evidence": "documented",
      "negative": "line",
      "negative_label": "Avoid:",
      "fixed_suffix": "No subtitles or on-screen text.",
      "params": {
        "ar": "Aspect ratio {v}.",
        "aspect": "Aspect ratio {v}.",
        "duration": "Duration {v} seconds.",
        "camera": "Camera: {v}."
      },
      "suffix_join": "\n\n",
      "doc_note": "Plain text; titles and Arabic typography are added later in the edit (clean plate), never generated inside the clip."
    }
  },
  "aliases": {
